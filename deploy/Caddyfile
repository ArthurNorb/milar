# Caddy na frente do Next, atrás do Cloudflare (SSL "Full (strict)").
#
# - TLS com o Cloudflare Origin Certificate (/etc/milar/certs no host).
# - Authenticated Origin Pulls: só aceita conexões que apresentem o
#   certificado de cliente do Cloudflare. Acesso direto ao IP da VPS falha
#   no handshake, mesmo que alguém descubra o IP.
# - IP real do visitante vem do CF-Connecting-IP, aceito só das faixas do
#   Cloudflare, e é repassado ao app em X-Real-IP (usado no rate limit).
#
# Faixas do Cloudflare: https://www.cloudflare.com/ips/ (revise de tempos em
# tempos; a mesma lista vai na Security List da VCN).

{
	admin off
	# Certificado é fornecido manualmente; nada de ACME.
	auto_https disable_redirects

	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
		timeouts {
			read_header 10s
			read_body 60s
			write 60s
			idle 120s
		}
		max_header_size 32KB
	}

	log {
		output stdout
		format json
		level INFO
	}
}

(cloudflare_tls) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		protocols tls1.2 tls1.3
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/certs/cloudflare-origin-pull-ca.pem
		}
	}
}

www.{$SITE_DOMAIN} {
	import cloudflare_tls
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	import cloudflare_tls

	log

	header {
		-Server
		-X-Powered-By
	}

	# Nada de arquivos ocultos ou sensíveis.
	@hidden path /.env* /.git* /.ht* /*.sql /*.bak /*.dump
	respond @hidden 404

	# Upload de foto do admin: 15 MB + folga do multipart.
	request_body {
		max_size 20MB
	}

	encode zstd gzip

	reverse_proxy app:3000 {
		header_up X-Real-IP {client_ip}
		header_up X-Forwarded-Proto https
		transport http {
			dial_timeout 5s
			response_header_timeout 60s
		}
	}
}

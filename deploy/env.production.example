# Copie para a raiz do repositório na VPS como .env.production e rode:
#   chmod 600 .env.production
# Nunca commite o arquivo real.

NEXT_PUBLIC_SITE_URL=https://milararquitetura.com.br

# Porta do app no 127.0.0.1 da VPS (o Nginx do host faz proxy para ela).
# Troque se já houver algo usando a 3010: confira com  sudo ss -ltnp | grep 3010
# e ajuste também o "upstream milar_app" em /etc/nginx/sites-available/milar.conf.
APP_PORT=3010

# Senha do Postgres (só hex, para caber na URL): openssl rand -hex 32
POSTGRES_PASSWORD=

# openssl rand -base64 48
SESSION_SECRET=
SESSION_VERSION=1

# Login do admin. Gere o hash na sua máquina: npm run hash-password -- "senha-longa"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

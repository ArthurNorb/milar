# Copie para a raiz do repositório na VPS como .env.production e rode:
#   chmod 600 .env.production
# Nunca commite o arquivo real.

# Domínio sem https:// (o Caddy atende ele e o www.)
SITE_DOMAIN=milararquitetura.com
NEXT_PUBLIC_SITE_URL=https://milararquitetura.com

# Senha do Postgres (só hex, para caber na URL): openssl rand -hex 32
POSTGRES_PASSWORD=

# openssl rand -base64 48
SESSION_SECRET=
SESSION_VERSION=1

# Login do admin. Gere o hash na sua máquina: npm run hash-password -- "senha-longa"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

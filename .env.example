# Postgres. No dev, o ./run sobe o banco via Docker e gera .env.development.local sozinho.
DATABASE_URL=postgres://milar:milar@127.0.0.1:54329/milar

# Chave que assina o cookie de sessão do admin (mín. 32 caracteres).
# Gere com: openssl rand -base64 48
SESSION_SECRET=

# Login do admin. Gere o hash com: npm run hash-password -- "sua-senha"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Pasta onde ficam as fotos enviadas pelo admin (caminho relativo à raiz do projeto ou absoluto)
UPLOADS_DIR=./.data/uploads

# URL pública do site (sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://milararquitetura.com
